# PhishNet serving environment (Phase 6).
#
# The Tier-1 serving container needs none of these: it defaults to the
# sealed, offline demo mode and reads thresholds/model hashes from the
# bundled manifests. These variables are only for the opt-in live Tier 2.
#
# Copy to `.env` and pass with `docker run --env-file .env ...`.

# Groq API key for live Tier-2 page judgments (p6-v1 prompt).
GROQ_API_KEY=your_groq_api_key_here

# Switch Tier 2 from the sealed replay to live fetch+judge.
PHISHNET_TIER2_MODE=live

# The separate Playwright fetcher service (backend/fetcher/Dockerfile),
# reachable from the serving container.
PHISHNET_FETCHER_URL=http://host.docker.internal:8100/fetch

# Optional: pinned extension ID for the CORS allowlist (the manifest key
# already pins this value; set it only to override).
# PHISHNET_EXTENSION_ID=cphacgebncakdmjbpoibajnihhbbcjec

# Optional: thresholds file override (default /app/reports/phase4.json).
# PHISHNET_THRESHOLDS_FILE=/app/reports/phase4.json
