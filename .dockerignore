# Keep the backend image build context lean (root-context build).
# Mirrors .gitignore semantics.
.venv/
.git/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
dist/
.env
*.env
data/
backend/urlset_ml_assets/
backend_env/
ml_training_env/
runs/**/cache/
.tld_cache/
# Reports the image does not need (thresholds + sealed manifest are copied
# explicitly by backend/Dockerfile).
reports/*
!reports/phase4.json
!reports/adversarial-manifest-p5.json
# Serving uses baked /app/models (backend/Dockerfile RUN verified_download),
# never the packaged 93 MB legacy ensemble or checked-in training assets.
src/phishnet/urlset_ml_assets/*.pkl
src/phishnet/urlset_ml_assets/*.pkl.tmp.*
backend/ablation_*_assets/*.pkl
backend/gbm_*_assets/*.pkl
backend/cc_ml_assets/*.pkl
backend/urlset_ml_assets/*.pkl
